# === SECURITY & SECRETS ===
# Never commit environment variables or secret keys
.env
.env.local
.env.*.local
*.pem
*.key
secret_key.txt

# === LOCAL DATABASES & USER DATA ===
# Never commit the SQLite database or user uploaded datasets
*.db
*.sqlite
*.sqlite3
openmlpipe.db
server/openmlpipe.db
server/data/
server/uploads/
uploads/

# === NODE / REACT (CLIENT) ===
node_modules/
client/node_modules/
dist/
client/dist/
client/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === PYTHON / FASTAPI (SERVER) ===
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
# C extensions
*.so
# Virtual environments
venv/
env/
ENV/
server/venv/
# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# === DOCKER ===
# Ignore local docker volumes if not using bind mounts
.docker/
docker-compose.override.yml

# === IDE, EDITOR & TOOLING FILES ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.playwright-mcp/

# === LOGS ===
logs/
*.log
